{
  "name": "@local-pii/core",
  "version": "0.1.0",
  "description": "Adapter-first PII protection for Expo, React Native, browsers, and Node. Protect personal information before a model boundary, then restore it inside the caller's trust boundary.",
  "keywords": [
    "expo",
    "react-native",
    "pii",
    "privacy",
    "anonymization",
    "redaction",
    "llm",
    "onnx",
    "on-device",
    "gdpr"
  ],
  "license": "MIT",
  "author": "Carlos Ricardo Ziegler <carlos.ziegler@zietec.io>",
  "homepage": "https://github.com/CarlosZiegler/local-pii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosZiegler/local-pii.git",
    "directory": "packages/local-pii"
  },
  "bugs": {
    "url": "https://github.com/CarlosZiegler/local-pii/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "require": "./dist/expo.cjs"
    },
    "./metro": {
      "types": "./dist/metro.d.ts",
      "import": "./dist/metro.js",
      "require": "./dist/metro.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js",
      "require": "./dist/openai.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "require": "./dist/ai-sdk.cjs"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js",
      "require": "./dist/inline.cjs"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "import": "./dist/tanstack.js",
      "require": "./dist/tanstack.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rslib build",
    "prepublishOnly": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:matrix": "bun run build && node scripts/verify-import-matrix.mjs && tsc -p test/import-matrix/tsconfig.node.json && tsc -p test/import-matrix/tsconfig.bundler.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "@local-pii/model-rampart": "*",
    "@tanstack/ai": "0.43.1",
    "@tanstack/ai-client": "0.23.1",
    "ai": ">=6 <8",
    "expo-asset": "*",
    "expo-crypto": "*",
    "expo-file-system": "*",
    "expo-secure-store": "*",
    "onnxruntime-react-native": "*",
    "onnxruntime-web": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@local-pii/model-rampart": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    },
    "@tanstack/ai-client": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "expo-asset": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "onnxruntime-react-native": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@local-pii/model-rampart": "workspace:*",
    "@microsoft/api-extractor": "^7.58.12",
    "@rslib/core": "^0.23.2",
    "@tanstack/ai": "0.43.1",
    "@tanstack/ai-client": "0.23.1",
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "ai": "^7.0.57",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "fast-check": "^4.9.0",
    "onnxruntime-node": "^1.27.0",
    "onnxruntime-web": "^1.27.0",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "zod": "^3.25.0"
  }
}
