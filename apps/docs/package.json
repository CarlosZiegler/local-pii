{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3001",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 3001",
    "copy-model": "mkdir -p public/models && cp -f ../../packages/model-rampart/assets/rampart-q4.onnx ../../packages/model-rampart/assets/vocab.json ../../packages/model-rampart/assets/labels.json public/models/",
    "deploy": "bun run copy-model && next build && bunx wrangler pages deploy out --project-name=local-pii-docs --branch=main --commit-dirty=true",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.61",
    "@browser-ai/core": "3.0.0",
    "@huggingface/transformers": "4.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/ai": "0.43.1",
    "@tanstack/ai-client": "0.23.1",
    "@tanstack/ai-react": "0.19.1",
    "ai": "7.0.57",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "fumadocs-core": "^16.14.2",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.2",
    "local-pii": "workspace:*",
    "lucide-react": "^1.30.0",
    "nanoid": "^6.0.1",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "^2.5.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/dom-chromium-ai": "0.0.17",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "30.0.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
